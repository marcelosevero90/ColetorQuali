&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE goToKey DBOProgram 
PROCEDURE goToKey :
/*------------------------------------------------------------------------------
  Purpose:     Reposiciona registro com base no °ndice ch-pk
  Parameters:  
               recebe valor do campo cod-usuario
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER pcod-usuario LIKE fmsc-usuar-mestre.cod-usuario NO-UNDO.

    FIND FIRST bffmsc-usuar-mestre WHERE 
        bffmsc-usuar-mestre.cod-usuario = pcod-usuario NO-LOCK NO-ERROR.

    /*--- Verifica se registro foi encontrado, em caso de erro ser† retornada flag "NOK":U ---*/
    IF NOT AVAILABLE bffmsc-usuar-mestre THEN 
        RETURN "NOK":U.

    /*--- Reposiciona query atravÇs de rowid e verifica a ocorrància de erros, caso
          existam erros ser† retornada flag "NOK":U ---*/
    RUN repositionRecord IN THIS-PROCEDURE (INPUT ROWID(bffmsc-usuar-mestre)).
    IF RETURN-VALUE = "NOK":U THEN
        RETURN "NOK":U.

    RETURN "OK":U.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE linkToByCodUsuario DBOProgram 
PROCEDURE linkToByCodUsuario :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT PARAMETER pHandle AS HANDLE NO-UNDO.

    RUN getKey IN pHandle(OUTPUT c-cod-usuar-lkn).

    RUN setConstraintByLinkCodUsuario IN THIS-PROCEDURE(INPUT c-cod-usuar-lkn).

    RETURN "OK":U.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE openQueryByCodUsuario DBOProgram 
PROCEDURE openQueryByCodUsuario :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    OPEN QUERY {&QueryName}
        FOR EACH {&TableName} 
            WHERE {&TableName}.cod-usuario >= c-cod-usuario-ini
            AND   {&TableName}.cod-usuario <= c-cod-usuario-fim NO-LOCK
            BY    {&TableName}.cod-usuario INDEXED-REPOSITION.

    RETURN "OK":U . 
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

